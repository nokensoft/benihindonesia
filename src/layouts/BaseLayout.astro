---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, orgId, websiteId } from '../data/site';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    /** schema.org type for this page (WebPage, AboutPage, ContactPage) */
    pageType?: string;
    /** Name used in structured data; defaults to the title */
    pageName?: string;
    /** Breadcrumb label for sub pages; omit on the home page */
    breadcrumb?: string;
    /** Extra schema.org nodes appended to the page graph */
    schema?: Record<string, unknown>[];
    noindex?: boolean;
}

const {
    title,
    description,
    pageType = 'WebPage',
    pageName = title,
    breadcrumb,
    schema = [],
    noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;

const graph: Record<string, unknown>[] = [];
if (breadcrumb) {
    graph.push(
        {
            '@type': pageType,
            '@id': `${canonical}#webpage`,
            url: canonical,
            name: pageName,
            inLanguage: 'id-ID',
            isPartOf: { '@id': websiteId },
            about: { '@id': orgId },
            breadcrumb: { '@id': `${canonical}#breadcrumb` },
        },
        {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
                { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
            ],
        },
    );
}
graph.push(...schema);
const jsonLd = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }) : null;
---
<!doctype html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}>
    {!noindex && <link rel="canonical" href={canonical}>}
    <meta name="theme-color" content="#166534">

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={site.name}>
    <meta property="og:locale" content="id_ID">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Logo Benih Indonesia">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/img/brand/favicon-32.png">
    <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="sitemap" href="/sitemap-index.xml">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body class="bg-stone-50 text-stone-800 font-sans antialiased flex flex-col min-h-screen">
    <Header />

    <main id="main" class="flex-grow">
        <slot />
    </main>

    <Footer />

    <script>
        import '../scripts/main.js';
    </script>
</body>
</html>
