---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const threeCs = [
    {
        en: 'Clarity',
        id: 'Kejelasan',
        text: 'Kami mengidentifikasi tingkat kemampuan membaca dan berhitung setiap anak melalui asesmen diagnostik sederhana dan mengelompokkan siswa berdasarkan kemampuan aktual mereka. Dengan demikian, guru sukarelawan dapat memberikan pembelajaran yang terarah sesuai dengan kebutuhan setiap anak.',
    },
    {
        en: 'Confidence',
        id: 'Kepercayaan Diri',
        text: 'Kami membangun kepercayaan diri anak melalui kegiatan belajar yang aktif, interaktif, dan menyenangkan, dengan menggunakan cerita lokal yang dekat dengan kehidupan sehari-hari mereka. Pengalaman belajar yang bermakna membantu anak tumbuh menjadi pembaca yang lebih percaya diri dan termotivasi.',
    },
    {
        en: 'Consistency',
        id: 'Keberlanjutan',
        text: 'Kami mendukung keberlanjutan penerapan TaRL melalui kunjungan sekolah secara berkala, pemantauan pembelajaran di kelas, dan pendampingan lanjutan bagi guru. Upaya ini membantu sekolah mempertahankan praktik pembelajaran yang efektif dan menjaga kemajuan belajar siswa setelah intervensi awal.',
    },
];

const beneficiaries = [
    { title: 'Guru Relawan', text: 'Relawan pengajar lokal terpilih dan terlatih.' },
    { title: 'Peserta Didik', text: 'Anak-anak penerima manfaat program literasi dan numerasi.' },
    { title: 'Masyarakat', text: 'Komunitas dan keluarga yang merasakan dampak positif.' },
];
---
<BaseLayout
    title="Dampak Program & Kerangka 3Cs | Benih Indonesia"
    description="Dampak Benih Indonesia melalui kerangka 3Cs (Clarity, Confidence, Consistency) bagi guru relawan, peserta didik, dan masyarakat, dimulai dari Papua."
    pageType="WebPage"
    pageName="Dampak Program Benih Indonesia"
    breadcrumb="Dampak"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
        <Breadcrumb label="Dampak" />

        <h1 class="text-3xl font-bold text-stone-900 mb-8">Dampak</h1>

        <div class="space-y-14">
            <section>
                <h2 class="text-2xl font-bold text-stone-900 mb-8"><span translate="no">3Cs</span></h2>
                <!-- Kartu muncul dari bawah, lalu mengambang pelan dan terangkat saat disorot -->
                <ol class="grid md:grid-cols-3 gap-6 md:gap-8 pb-4">
                    {threeCs.map((c, i) => (
                        <li data-reveal="up" style={`--reveal-delay:${i * 160}ms`}>
                            <article class="lift-card h-full p-6 bg-white border border-stone-200 rounded-xl" style={`--float-delay:${i * -2}s`}>
                                <p class="text-sm font-bold text-brand-700 mb-1" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                                <h3 class="text-xl font-bold text-brand-800 mb-3"><span translate="no">{c.en}</span> | {c.id}</h3>
                                <p class="text-stone-600 leading-relaxed">{c.text}</p>
                            </article>
                        </li>
                    ))}
                </ol>
            </section>

            <section class="border-t border-stone-200 pt-10">
                <h2 class="text-2xl font-bold text-stone-900 mb-8">Testimoni dan Penerima Manfaat dalam Angka</h2>
                <ul class="grid md:grid-cols-3 gap-6 md:gap-8 mb-10 text-center pb-4">
                    {beneficiaries.map((b, i) => (
                        <li data-reveal="up" style={`--reveal-delay:${i * 160}ms`}>
                            <div class="lift-card h-full p-6 bg-stone-100 border border-stone-200 rounded-xl" style={`--float-delay:${i * -2}s`}>
                                <h3 class="text-2xl md:text-3xl font-bold text-brand-800">{b.title}</h3>
                                <p class="text-stone-600 mt-2">{b.text}</p>
                            </div>
                        </li>
                    ))}
                </ul>
                <p class="text-stone-700">Pelajari <a href="/programmes/" class="font-medium text-brand-700 hover:underline">program-program kami</a> yang menghasilkan dampak ini.</p>
            </section>
        </div>
    </div>
</BaseLayout>
