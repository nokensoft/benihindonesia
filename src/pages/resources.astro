---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Breadcrumb from '../components/Breadcrumb.astro';
import anakBelajar from '../assets/illustrations/anak-belajar.jpg';
---
<BaseLayout
    title="Metode Teaching at the Right Level (TaRL) | Benih Indonesia"
    description="Pelajari metode Teaching at the Right Level (TaRL): pengelompokan belajar berdasarkan kemampuan aktual anak agar setiap anak belajar sesuai kecepatannya."
    pageType="WebPage"
    pageName="Metodologi Teaching at the Right Level (TaRL)"
    breadcrumb="Bahan Ajar"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
        <Breadcrumb label="Bahan Ajar" />

        <h1 class="text-3xl font-bold text-stone-900 mb-8">Bahan Ajar</h1>

        <Image
            src={anakBelajar}
            alt="Ilustrasi guru dan anak-anak belajar membaca dan berhitung bersama dengan buku, kartu huruf, dan gambar"
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="eager"
            class="w-full h-auto rounded-xl border border-stone-200 bg-white mb-10"
        />

        <section class="space-y-6" data-reveal="blur">
            <h2 class="text-2xl font-bold text-stone-900">Metode Kami (Teaching at the Right Level / TaRL)</h2>
            <p class="text-stone-700 leading-relaxed">
                Pendekatan Teaching at the Right Level (TaRL) membagi kelompok belajar berdasarkan tingkat kemampuan aktual anak (membaca huruf, kata, paragraf, atau cerita) bukan berdasarkan tingkatan kelas formalnya. Hal ini memungkinkan setiap anak belajar sesuai kecepatannya masing-masing hingga mencapai ketangkasan dasar.
            </p>
            <p class="text-stone-700">Lihat bagaimana TaRL diterapkan dalam <a href="/programmes/" class="font-medium text-brand-700 hover:underline">program kami</a>.</p>
        </section>
    </div>
</BaseLayout>
