---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { orgId } from '../data/site';
import silvia from '../assets/team/silvia.jpg';
import frederik from '../assets/team/frederik.jpg';

// Perjalanan Kami 2026–2030
const timeline = [
    {
        year: '2026',
        text: 'Penguatan metode TaRL dan perluasan cakupan pendampingan di Kabupaten Jayapura dan Kota Jayapura.',
        linkText: 'TaRL',
    },
    {
        year: '2028',
        text: 'Replikasi program di seluruh wilayah operasi target (Biak Numfor, Sarmi, Kepulauan Yapen, Nabire, Merauke, Fakfak).',
    },
    {
        year: '2030',
        text: 'Pencapaian kemandirian komunitas lokal dalam mengelola sentra-sentra belajar literasi secara mandiri.',
    },
];

// Mitra. Hanya mitra yang sudah final yang ditampilkan (confirmed: true).
// Logo diambil otomatis dari src/assets/partners/<id>.(png|jpg|jpeg|webp|svg) bila berkasnya ada.
const partners = [
    { id: 'd-prize', name: 'D-Prize', confirmed: true },
    { id: 'international-university-of-papua', name: 'International University of Papua', confirmed: false },
].filter((partner) => partner.confirmed);

const logoModules = import.meta.glob<ImageMetadata>('../assets/partners/*.{png,jpg,jpeg,webp,svg}', {
    eager: true,
    import: 'default',
});
const logoFor = (id: string) => {
    const key = Object.keys(logoModules).find((k) => k.split('/').pop()!.replace(/\.[^.]+$/, '') === id);
    return key ? logoModules[key] : undefined;
};

const page = new URL('/about/', Astro.site).href;
const photo = async (src: ImageMetadata) =>
    new URL((await getImage({ src, width: 480, format: 'jpg' })).src, Astro.site).href;

const schema = [
    {
        '@type': 'Person',
        '@id': `${page}#silvia-wambukomo`,
        name: 'Silvia Wambukomo',
        jobTitle: 'Co-founder',
        image: await photo(silvia),
        sameAs: ['https://www.linkedin.com/in/silvia-wambukomo-b4849a255'],
        worksFor: { '@id': orgId },
    },
    {
        '@type': 'Person',
        '@id': `${page}#frederick-m`,
        name: 'Frederick M.',
        jobTitle: 'Co-founder',
        image: await photo(frederik),
        sameAs: ['https://www.linkedin.com/in/frederick-m-2ab5a1281'],
        worksFor: { '@id': orgId },
    },
];
---
<BaseLayout
    title="Tentang Kami: Tim, Visi & Misi | Benih Indonesia"
    description="Kenali Benih Indonesia: organisasi, tim pendiri, visi dan misi, perjalanan 2026–2030, serta mitra kami dalam memajukan literasi dan numerasi anak-anak Indonesia, dimulai dari Papua."
    pageType="AboutPage"
    pageName="Tentang Benih Indonesia"
    breadcrumb="Tentang"
    schema={schema}
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
        <Breadcrumb label="Tentang" />

        <h1 class="text-3xl font-bold text-stone-900 mb-6">Tentang</h1>

        <!-- Navigasi di halaman (menempel di atas, dapat digeser ke samping di layar kecil) -->
        <nav aria-label="Di halaman ini" data-section-nav class="sticky top-16 lg:top-20 z-40 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0 bg-stone-50/95 backdrop-blur-md border-b border-stone-200 mb-10">
            <ul class="no-scrollbar flex gap-2 overflow-x-auto py-3 text-sm">
                <li class="shrink-0"><a href="#organization" class="block px-4 py-2 rounded-full border border-stone-300 bg-white text-stone-700 hover:border-brand-700 hover:text-brand-700 aria-[current=true]:bg-brand-800 aria-[current=true]:border-brand-800 aria-[current=true]:text-white">Tentang Kami</a></li>
                <li class="shrink-0"><a href="#team" class="block px-4 py-2 rounded-full border border-stone-300 bg-white text-stone-700 hover:border-brand-700 hover:text-brand-700 aria-[current=true]:bg-brand-800 aria-[current=true]:border-brand-800 aria-[current=true]:text-white">Tim Kami</a></li>
                <li class="shrink-0"><a href="#vision" class="block px-4 py-2 rounded-full border border-stone-300 bg-white text-stone-700 hover:border-brand-700 hover:text-brand-700 aria-[current=true]:bg-brand-800 aria-[current=true]:border-brand-800 aria-[current=true]:text-white">Visi dan Misi</a></li>
                <li class="shrink-0"><a href="#journey" class="block px-4 py-2 rounded-full border border-stone-300 bg-white text-stone-700 hover:border-brand-700 hover:text-brand-700 aria-[current=true]:bg-brand-800 aria-[current=true]:border-brand-800 aria-[current=true]:text-white">Perjalanan Kami</a></li>
                <li class="shrink-0"><a href="#partner" class="block px-4 py-2 rounded-full border border-stone-300 bg-white text-stone-700 hover:border-brand-700 hover:text-brand-700 aria-[current=true]:bg-brand-800 aria-[current=true]:border-brand-800 aria-[current=true]:text-white">Mitra Kami</a></li>
            </ul>
        </nav>

        <div class="space-y-12 md:space-y-16">
            <section id="organization" class="space-y-4 scroll-mt-16">
                <h2 class="text-2xl font-bold text-stone-900">Tentang Kami</h2>
                <p class="text-stone-700 leading-relaxed">
                    Benih Indonesia berdiri sebagai bentuk kepedulian mendalam terhadap tantangan pendidikan dasar di Indonesia yang dimulai dari Papua. Organisasi ini berfokus pada penyediaan akses dan metode belajar literasi dan numerasi yang inklusif, relevan, serta berkelanjutan bagi anak-anak di daerah perkotaan maupun pedesaan.
                </p>
            </section>

            <section id="team" class="space-y-6 scroll-mt-16">
                <h2 class="text-2xl font-bold text-stone-900">Tim Kami</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Silvia Wambukomo -->
                    <article id="silvia-wambukomo" class="p-5 sm:p-6 bg-white border border-stone-200 rounded-lg flex flex-col gap-4">
                        <div class="flex gap-4 items-start">
                            <Image src={silvia} alt="Foto Silvia Wambukomo, Co-founder Benih Indonesia" width={192} height={240} class="w-20 sm:w-24 aspect-[4/5] object-cover rounded-md shrink-0" />
                            <div class="min-w-0">
                                <h3 class="text-lg sm:text-xl font-bold text-stone-900">Silvia Wambukomo</h3>
                                <p class="text-sm text-stone-600 mt-1">MSc Education, Public Policy and Equity</p>
                                <p class="text-brand-700 font-medium mt-2">Co-founder</p>
                            </div>
                        </div>
                        <p class="text-stone-600">Mengawasi dan memimpin strategi pengembangan program literasi serta integrasi kurikulum berbasis komunitas lokal.</p>
                        <a href="https://www.linkedin.com/in/silvia-wambukomo-b4849a255" target="_blank" rel="noopener noreferrer" class="self-start inline-flex items-center gap-2 min-h-[44px] px-3 -mx-3 rounded-md text-sm font-medium text-stone-600 hover:text-brand-700 hover:bg-stone-50 transition-colors">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.78a1.68 1.68 0 1 0 0 3.36 1.68 1.68 0 0 0 0-3.36Z"/>
                            </svg>
                            LinkedIn<span class="sr-only"> Silvia Wambukomo (tab baru)</span>
                        </a>
                    </article>

                    <!-- Frederick M. -->
                    <article id="frederick-m" class="p-5 sm:p-6 bg-white border border-stone-200 rounded-lg flex flex-col gap-4">
                        <div class="flex gap-4 items-start">
                            <Image src={frederik} alt="Foto Frederick M., Co-founder Benih Indonesia" width={192} height={240} class="w-20 sm:w-24 aspect-[4/5] object-cover rounded-md shrink-0" />
                            <div class="min-w-0">
                                <h3 class="text-lg sm:text-xl font-bold text-stone-900">Frederick M.</h3>
                                <p class="text-sm text-stone-600 mt-1">MSc Management with Enterprise and Business Growth</p>
                                <p class="text-brand-700 font-medium mt-2">Co-founder</p>
                            </div>
                        </div>
                        <p class="text-stone-600">Mengelola kemitraan strategis, operasional lapangan, dan pengembangan jaringan sukarelawan di berbagai wilayah operasional.</p>
                        <a href="https://www.linkedin.com/in/frederick-m-2ab5a1281" target="_blank" rel="noopener noreferrer" class="self-start inline-flex items-center gap-2 min-h-[44px] px-3 -mx-3 rounded-md text-sm font-medium text-stone-600 hover:text-brand-700 hover:bg-stone-50 transition-colors">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.78a1.68 1.68 0 1 0 0 3.36 1.68 1.68 0 0 0 0-3.36Z"/>
                            </svg>
                            LinkedIn<span class="sr-only"> Frederick M. (tab baru)</span>
                        </a>
                    </article>
                </div>
            </section>

            <section id="vision" class="space-y-6 scroll-mt-16">
                <h2 class="text-2xl font-bold text-stone-900">Visi dan Misi</h2>
                <div class="space-y-4">
                    <div>
                        <h3 class="text-xl font-semibold text-stone-900 mb-2">Visi</h3>
                        <p class="text-stone-700">Menjadi lembaga yang berkontribusi dalam peningkatan literasi dan numerasi, penguatan kapasitas pengajar, serta pemberdayaan komunitas lokal demi terciptanya lingkungan belajar yang berkelanjutan.</p>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-stone-900 mb-2">Misi</h3>
                        <p class="text-stone-700">Memaksimalkan potensi setiap anak Indonesia melalui penguatan fondasi belajar.</p>
                    </div>
                </div>
            </section>

            <section id="journey" class="space-y-6 scroll-mt-16">
                <h2 class="text-2xl font-bold text-stone-900">Perjalanan Kami: 2026–2030</h2>
                <!-- Tahun dan target capaian muncul dengan efek blur reveal saat masuk layar -->
                <ol class="space-y-10 border-l-2 border-brand-100 pl-6 sm:pl-8 ml-2" data-timeline>
                    {timeline.map((item) => (
                        <li id={`journey-${item.year}`} class="relative" data-timeline-item>
                            <span class="absolute -left-[2.2rem] sm:-left-[2.7rem] top-2 h-4 w-4 rounded-full border-4 border-white bg-brand-700 shadow" aria-hidden="true"></span>
                            <p data-reveal="blur" class="text-4xl sm:text-5xl font-bold text-brand-700 leading-none">{item.year}</p>
                            <p data-reveal="blur" style="--reveal-delay:180ms" class="mt-3 text-lg text-stone-700 max-w-2xl">
                                {item.linkText ? (
                                    <>
                                        {item.text.split(item.linkText)[0]}<a href="/resources/" class="underline decoration-stone-300 hover:text-brand-700">{item.linkText}</a>{item.text.split(item.linkText).slice(1).join(item.linkText)}
                                    </>
                                ) : item.text}
                            </p>
                        </li>
                    ))}
                </ol>
                <p class="text-stone-700"><a href="/stories/#peta" class="font-medium text-brand-700 hover:underline">Lihat peta wilayah operasi</a>.</p>
            </section>

            <section id="partner" class="space-y-4 scroll-mt-16">
                <h2 class="text-2xl font-bold text-stone-900">Mitra Kami</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                    {partners.map((partner) => {
                        const logo = logoFor(partner.id);
                        return (
                            <div class="p-6 bg-white border border-stone-200 rounded-lg flex items-center gap-4">
                                {logo && <Image src={logo} alt={`Logo ${partner.name}`} height={64} class="h-16 w-auto max-w-[8rem] object-contain" />}
                                <h3 class="text-xl font-bold text-stone-900" translate="no">{partner.name}</h3>
                            </div>
                        );
                    })}
                </div>
                <p class="text-stone-700">Tertarik menjadi mitra? <a href="/get-involved/" class="font-medium text-brand-700 hover:underline">Daftar sebagai Mitra Kolaborasi</a>.</p>
            </section>
        </div>
    </div>
</BaseLayout>
