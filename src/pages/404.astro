---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman Tidak Ditemukan | Benih Indonesia" description="Halaman yang Anda cari tidak ditemukan." noindex>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center space-y-6">
        <p class="text-sm font-bold text-brand-700">404</p>
        <h1 class="text-3xl md:text-4xl font-bold text-stone-900">Halaman tidak ditemukan</h1>
        <p class="text-stone-700">Maaf, halaman yang Anda cari tidak tersedia atau telah dipindahkan.</p>
        <a href="/" class="inline-block px-6 py-3 bg-brand-800 text-white font-medium rounded-md hover:bg-brand-700 transition-colors">Kembali ke Home</a>
    </div>
</BaseLayout>
