---
// Peta situs untuk pengunjung (versi XML untuk mesin pencari: /sitemap-index.xml)
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { nav, cta, legal } from '../data/site';

// Bagian di dalam halaman yang layak ditautkan langsung
const sections: Record<string, { href: string; label: string }[]> = {
    '/about/': [
        { href: '/about/#organization', label: 'Tentang Kami' },
        { href: '/about/#team', label: 'Tim Kami' },
        { href: '/about/#vision', label: 'Visi dan Misi' },
        { href: '/about/#journey', label: 'Perjalanan Kami 2026–2030' },
        { href: '/about/#partner', label: 'Mitra Kami' },
    ],
    '/stories/': [{ href: '/stories/#peta', label: 'Jalur Perluasan Kami (peta)' }],
};

const pages = [...nav, cta];
---
<BaseLayout
    title="Peta Situs | Benih Indonesia"
    description="Daftar seluruh halaman di situs Benih Indonesia."
    pageName="Peta Situs Benih Indonesia"
    breadcrumb="Peta Situs"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
        <Breadcrumb label="Peta Situs" />

        <h1 class="text-3xl font-bold text-stone-900 mb-8">Peta Situs</h1>

        <div class="grid gap-10 md:grid-cols-2">
            <section>
                <h2 class="text-xl font-bold text-stone-900 mb-4">Halaman</h2>
                <ul class="space-y-3 text-stone-700">
                    {pages.map((page) => (
                        <li>
                            <a href={page.href} class="font-medium text-brand-700 hover:underline">{page.label}</a>
                            {sections[page.href] && (
                                <ul class="mt-2 ml-4 pl-4 border-l border-stone-200 space-y-2 text-sm">
                                    {sections[page.href].map((s) => (
                                        <li><a href={s.href} class="hover:text-brand-700 hover:underline">{s.label}</a></li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                </ul>
            </section>
            <section>
                <h2 class="text-xl font-bold text-stone-900 mb-4">Informasi</h2>
                <ul class="space-y-3 text-stone-700">
                    {legal.map((item) => (
                        <li><a href={item.href} class="font-medium text-brand-700 hover:underline">{item.label}</a></li>
                    ))}
                </ul>
            </section>
        </div>
    </div>
</BaseLayout>
