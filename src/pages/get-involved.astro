---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';
---
<BaseLayout
    title="Donasi, Relawan & Kemitraan | Benih Indonesia"
    description="Ikut terlibat bersama Benih Indonesia: berdonasi, menjadi relawan pengajar, atau berkolaborasi sebagai mitra untuk literasi anak-anak Papua."
    pageType="WebPage"
    pageName="Donasi, Relawan, dan Kemitraan Benih Indonesia"
    breadcrumb="Get Involved"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
        <Breadcrumb label="Get Involved" />

        <h1 class="text-3xl font-bold text-stone-900 mb-4">Get Involved</h1>
        <p class="text-stone-700 leading-relaxed mb-8 md:mb-10 max-w-2xl">Dukung literasi dan numerasi anak-anak Papua melalui donasi, menjadi relawan pengajar, atau berkolaborasi sebagai mitra.</p>

        <section class="space-y-6 md:space-y-8">
            <h2 class="text-2xl font-bold text-stone-900">Registration Form</h2>
            <form data-whatsapp-form data-wa-number={site.whatsapp} class="max-w-2xl space-y-5 bg-white p-5 sm:p-6 border border-stone-200 rounded-lg">
                <p class="text-sm text-stone-600">Kolom bertanda <span class="text-red-700" aria-hidden="true">*</span><span class="sr-only">bintang</span> wajib diisi.</p>
                <div>
                    <label for="reg-category" class="block text-sm font-medium text-stone-700 mb-1">Kategori Keterlibatan</label>
                    <select id="reg-category" name="category" class="w-full border border-stone-300 rounded-md px-3 py-3 text-base sm:text-sm bg-white focus:border-brand-700 focus:ring-2 focus:ring-brand-700/30 focus:outline-none">
                        <option value="donation">Donation</option>
                        <option value="volunteer">Volunteers</option>
                        <option value="partner">Collaborating Partners</option>
                    </select>
                </div>
                <div>
                    <label for="reg-name" class="block text-sm font-medium text-stone-700 mb-1">Nama Lengkap / Instansi <span class="text-red-700" aria-hidden="true">*</span></label>
                    <input id="reg-name" name="name" type="text" autocomplete="name" required class="w-full border border-stone-300 rounded-md px-3 py-3 text-base sm:text-sm bg-white focus:border-brand-700 focus:ring-2 focus:ring-brand-700/30 focus:outline-none" placeholder="Nama lengkap atau nama lembaga">
                </div>
                <div>
                    <label for="reg-email" class="block text-sm font-medium text-stone-700 mb-1">Email Kontak <span class="text-red-700" aria-hidden="true">*</span></label>
                    <input id="reg-email" name="email" type="email" autocomplete="email" required class="w-full border border-stone-300 rounded-md px-3 py-3 text-base sm:text-sm bg-white focus:border-brand-700 focus:ring-2 focus:ring-brand-700/30 focus:outline-none" placeholder="email@domain.com">
                </div>
                <div>
                    <label for="reg-phone" class="block text-sm font-medium text-stone-700 mb-1">Nomor Telepon / WhatsApp</label>
                    <input id="reg-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" class="w-full border border-stone-300 rounded-md px-3 py-3 text-base sm:text-sm bg-white focus:border-brand-700 focus:ring-2 focus:ring-brand-700/30 focus:outline-none" placeholder="+62 ...">
                </div>
                <div>
                    <label for="reg-notes" class="block text-sm font-medium text-stone-700 mb-1">Catatan Tambahan</label>
                    <textarea id="reg-notes" name="notes" rows="3" class="w-full border border-stone-300 rounded-md px-3 py-3 text-base sm:text-sm bg-white focus:border-brand-700 focus:ring-2 focus:ring-brand-700/30 focus:outline-none" placeholder="Sampaikan detail niat dukungan atau rencana kolaborasi..."></textarea>
                </div>
                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-brand-800 text-white font-medium py-3 rounded-md hover:bg-brand-700 transition-colors text-base"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.36A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.08.8.82-3-.2-.31a8.2 8.2 0 1 1 6.94 3.84Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06a6.7 6.7 0 0 1-3.34-2.92c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.74 2.74 0 0 0-.86 2.04 4.76 4.76 0 0 0 1 2.53 10.9 10.9 0 0 0 4.17 3.68c1.55.67 2.16.73 2.94.61.47-.07 1.46-.6 1.66-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.47-.28Z"/></svg> Kirim via WhatsApp</button>
                <p class="text-sm text-stone-600 text-center">Pendaftaran akan dikirim sebagai pesan WhatsApp ke <span class="notranslate whitespace-nowrap" translate="no">{site.whatsappDisplay}</span>.</p>
                <p data-form-status role="status" tabindex="-1" class="hidden text-sm rounded-md p-3 bg-brand-50 border border-brand-100 text-brand-900"></p>
            </form>
            <p class="text-stone-700">Ingin berkunjung langsung? <a href="/contact/" class="font-medium text-brand-700 hover:underline">Lihat alamat kami</a>.</p>
        </section>
    </div>
</BaseLayout>
