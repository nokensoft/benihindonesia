---
import { Image } from 'astro:assets';
import LangSwitch from './LangSwitch.astro';
import { nav, cta, site } from '../data/site';
import logo from '../assets/logo.png';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
---
<a href="#main" translate="no" class="notranslate sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:px-4 focus:py-3 focus:rounded-md focus:shadow">Skip to main content</a>

<header class="sticky top-0 z-50 bg-stone-50/95 backdrop-blur-md border-b border-stone-200" data-site-header>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between gap-4 h-16 lg:h-20 items-center">

            <!-- Logo -->
            <a class="notranslate flex items-center gap-2 min-w-0 text-lg sm:text-xl xl:text-2xl font-bold tracking-tight text-brand-800 uppercase whitespace-nowrap" href="/" translate="no">
                <Image src={logo} alt="" width={96} height={96} loading="eager" class="h-10 w-10 lg:h-12 lg:w-12 shrink-0 object-contain rounded-full" />
                <span class="flex flex-col min-w-0 leading-tight">
                    <span>{site.name}</span>
                    <span class="text-[11px] sm:text-xs font-medium normal-case tracking-normal text-stone-600 truncate">{site.tagline}</span>
                </span>
            </a>

            <!-- Desktop Navigation -->
            <nav aria-label="Main navigation" translate="no" class="notranslate hidden xl:flex items-center gap-6 whitespace-nowrap">
                {nav.map((item) => (
                    <a href={item.href} aria-current={current(item.href)} class="py-2 text-sm transition-colors border-b-2 border-transparent text-stone-600 hover:text-stone-900 aria-[current=page]:text-brand-700 aria-[current=page]:font-semibold aria-[current=page]:border-brand-700">{item.label}</a>
                ))}
                <LangSwitch variant="desktop" />
                <a href={cta.href} aria-current={current(cta.href)} class="px-4 py-2 text-sm rounded-md transition-colors bg-brand-800 text-white hover:bg-brand-700 aria-[current=page]:bg-brand-700">{cta.label}</a>
            </nav>

            <!-- Mobile Menu Button -->
            <button type="button" class="xl:hidden -mr-2 inline-flex items-center justify-center w-11 h-11 shrink-0 rounded-md text-stone-700 hover:text-stone-900 hover:bg-stone-100" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu" translate="no" data-menu-toggle>
                <svg data-icon-open class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <svg data-icon-close class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <nav id="mobile-menu" aria-label="Mobile navigation" translate="no" class="notranslate hidden xl:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-stone-200 bg-stone-50 px-4 pt-3 pb-5 shadow-lg">
        <ul class="space-y-1">
            {nav.map((item) => (
                <li><a href={item.href} aria-current={current(item.href)} class="block px-3 py-3 rounded-md text-base text-stone-700 hover:bg-stone-100 aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700 aria-[current=page]:font-semibold">{item.label}</a></li>
            ))}
        </ul>
        <LangSwitch variant="mobile" />
        <a href={cta.href} aria-current={current(cta.href)} class="mt-3 block px-3 py-3 rounded-md bg-brand-800 text-white text-base font-medium text-center hover:bg-brand-700">{cta.label}</a>
    </nav>
</header>
