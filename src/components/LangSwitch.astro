---
// ID/EN toggle; behaviour lives in src/scripts/main.js ([data-lang-switch]).
interface Props {
    variant?: 'desktop' | 'mobile';
}
const { variant = 'desktop' } = Astro.props;

const globe = 'M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z';
const desktopBtn = 'px-2.5 py-1 rounded-full text-stone-600 hover:text-stone-900 aria-[pressed=true]:bg-brand-800 aria-[pressed=true]:text-white';
const mobileBtn = 'min-w-[3.25rem] min-h-[2.5rem] px-3 rounded-full text-stone-600 aria-[pressed=true]:bg-brand-800 aria-[pressed=true]:text-white';
---
{variant === 'desktop' ? (
    <div role="group" aria-label="Choose language" translate="no" class="notranslate inline-flex items-center gap-1 rounded-full border border-stone-300 bg-white p-0.5 text-xs font-semibold" data-lang-switch>
        <svg class="w-4 h-4 ml-1.5 text-stone-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d={globe}/></svg>
        <button type="button" lang="id" data-lang="id" aria-pressed="true" title="Bahasa Indonesia" class={desktopBtn}>ID</button>
        <button type="button" lang="en" data-lang="en" aria-pressed="false" title="English" class={desktopBtn}>EN</button>
    </div>
) : (
    <div class="mt-3 flex items-center justify-between gap-3 px-3 py-2 rounded-md border border-stone-200 bg-white">
        <span class="flex items-center gap-2 text-sm text-stone-600">
            <svg class="w-5 h-5 text-stone-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d={globe}/></svg>
            <span>Language</span>
        </span>
        <div role="group" aria-label="Choose language" translate="no" class="notranslate inline-flex rounded-full border border-stone-300 bg-stone-50 p-1 text-sm font-semibold" data-lang-switch>
            <button type="button" lang="id" data-lang="id" aria-pressed="true" class={mobileBtn}>ID</button>
            <button type="button" lang="en" data-lang="en" aria-pressed="false" class={mobileBtn}>EN</button>
        </div>
    </div>
)}
