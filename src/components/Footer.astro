---
import { nav, cta, site, fullAddress, social, legal } from '../data/site';

const links = [...nav.filter((item) => item.href !== '/'), cta];

// Ikon media sosial (24×24)
const icons: Record<string, string> = {
    linkedin: '<path fill="currentColor" stroke="none" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.78a1.68 1.68 0 1 0 0 3.36 1.68 1.68 0 0 0 0-3.36Z"/>',
    instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>',
    facebook: '<path fill="currentColor" stroke="none" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21h3Z"/>',
    whatsapp: '<path d="M4 20l1.2-3.9A8.2 8.2 0 1 1 8.1 19Z"/><path fill="currentColor" stroke="none" d="M9.3 7.6c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.5l-.5.6c-.1.1-.1.3 0 .4.6 1.1 1.5 1.9 2.6 2.4.2.1.3.1.4-.1l.6-.7c.1-.2.3-.2.5-.1l1.6.8c.2.1.3.2.3.4 0 .9-.7 1.7-1.6 1.8-.6.1-1.5 0-3-.7-2.1-1-3.5-3.1-3.7-3.5-.2-.3-.9-1.3-.8-2.4 0-.6.4-1.1.9-1.4h.6Z"/>',
    youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path fill="currentColor" stroke="none" d="M10 9.2v5.6l4.8-2.8Z"/>',
};
const iconBox = 'inline-flex items-center justify-center w-11 h-11 rounded-full border';
---
<footer class="bg-stone-100 border-t border-stone-200 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-[max(2.5rem,env(safe-area-inset-bottom))] md:pt-12">
        <div class="grid gap-8 md:grid-cols-3 text-sm text-stone-600">
            <div class="space-y-3">
                <div class="notranslate" translate="no">
                    <p class="text-base font-bold text-brand-800 uppercase tracking-tight">{site.name}</p>
                    <p class="text-sm font-medium text-stone-700">{site.tagline}</p>
                </div>
                <p>Organisasi nirlaba untuk literasi dan numerasi anak-anak di Indonesia.</p>
            </div>
            <nav aria-label="Navigasi footer">
                <p class="font-semibold text-stone-900 mb-2">Jelajahi</p>
                <ul class="grid grid-cols-2 gap-x-4">
                    {links.map((item) => (
                        <li><a href={item.href} class="inline-block py-2 hover:text-stone-900">{item.label}</a></li>
                    ))}
                </ul>
            </nav>
            <div class="space-y-6">
                <address class="not-italic">
                    <p class="font-semibold text-stone-900 mb-2">Kontak</p>
                    <p class="py-2">{fullAddress}</p>
                    <p><a href={`mailto:${site.email}`} translate="no" class="notranslate inline-block py-2 break-all hover:text-stone-900">{site.email}</a></p>
                </address>
                <div>
                    <p class="font-semibold text-stone-900 mb-3">Ikuti Kami</p>
                    <ul class="flex flex-wrap gap-2" data-social translate="no">
                        {social.map((item) => (
                            <li>
                                {item.href ? (
                                    <a href={item.href} target="_blank" rel="noopener noreferrer" title={item.label} class={`${iconBox} border-stone-300 bg-white text-stone-700 hover:border-brand-700 hover:text-brand-700 transition-colors`}>
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.id]} />
                                        <span class="sr-only">{item.label} Benih Indonesia (tab baru)</span>
                                    </a>
                                ) : (
                                    <span title={`${item.label} (segera hadir)`} class={`${iconBox} border-dashed border-stone-300 text-stone-500`}>
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.id]} />
                                        <span class="sr-only">{item.label} (segera hadir)</span>
                                    </span>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
        <div class="mt-8 pt-6 border-t border-stone-200 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between text-sm text-stone-600">
            <p>&copy; {new Date().getFullYear()} Benih Indonesia. Hak cipta dilindungi.</p>
            <nav aria-label="Tautan legal">
                <ul class="flex items-center gap-3">
                    {legal.map((item, i) => (
                        <>
                            {i > 0 && <li aria-hidden="true" class="text-stone-400">|</li>}
                            <li><a href={item.href} class="inline-block py-2 hover:text-stone-900">{item.label}</a></li>
                        </>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</footer>
