---
import { nav, cta, site, fullAddress } from '../data/site';

const links = [...nav.filter((item) => item.href !== '/'), cta];
---
<footer class="bg-stone-100 border-t border-stone-200 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-[max(2.5rem,env(safe-area-inset-bottom))] md:pt-12">
        <div class="grid gap-8 md:grid-cols-3 text-sm text-stone-600">
            <div class="space-y-3">
                <p class="notranslate text-base font-bold text-brand-800 uppercase tracking-tight" translate="no">Benih Indonesia</p>
                <p>Organisasi nirlaba untuk literasi dan numerasi dasar anak-anak di tanah Papua.</p>
            </div>
            <nav aria-label="Footer navigation" translate="no" class="notranslate">
                <p class="font-semibold text-stone-900 mb-2">Explore</p>
                <ul class="grid grid-cols-2 gap-x-4">
                    {links.map((item) => (
                        <li><a href={item.href} class="inline-block py-2 hover:text-stone-900">{item.label}</a></li>
                    ))}
                </ul>
            </nav>
            <address class="not-italic">
                <p class="notranslate font-semibold text-stone-900 mb-2" translate="no">Contact</p>
                <p class="py-2">{fullAddress}</p>
                <p><a href={`mailto:${site.email}`} translate="no" class="notranslate inline-block py-2 break-all hover:text-stone-900">{site.email}</a></p>
            </address>
        </div>
        <p class="mt-8 pt-6 border-t border-stone-200 text-sm text-stone-600">&copy; {new Date().getFullYear()} Benih Indonesia. All rights reserved.</p>
    </div>
</footer>
